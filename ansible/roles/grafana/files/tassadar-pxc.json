{
  "uid": "tassadar-pxc",
  "title": "Tassadar — PXC",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "tags": [
    "tassadar",
    "pxc"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "MySQL reachable",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "tassadar-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "orange"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mysql_up{job=\"mysql\"}",
          "legendFormat": "{{instance}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 2,
      "title": "Galera component size",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "tassadar-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mysql_global_status_wsrep_cluster_size{job=\"mysql\"}",
          "legendFormat": "{{instance}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "title": "Galera component status",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "tassadar-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Non-primary / disconnected",
                  "color": "orange"
                },
                "1": {
                  "text": "Primary",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mysql_global_status_wsrep_cluster_status{job=\"mysql\"}",
          "legendFormat": "{{instance}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 4,
      "title": "Galera node state",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "tassadar-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Undefined",
                  "color": "orange"
                },
                "1": {
                  "text": "Joining",
                  "color": "orange"
                },
                "2": {
                  "text": "Donor / desynced",
                  "color": "orange"
                },
                "3": {
                  "text": "Joined",
                  "color": "orange"
                },
                "4": {
                  "text": "Synced",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mysql_global_status_wsrep_local_state{job=\"mysql\"}",
          "legendFormat": "{{instance}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 5,
      "title": "MySQL workload",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 6,
      "title": "Open MySQL connections",
      "description": "Currently open client connections, including idle sessions.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tassadar-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mysql_global_status_threads_connected{job=\"mysql\",instance=~\"pxc-[0-9]+\"}",
          "legendFormat": "{{instance}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "title": "Running MySQL threads",
      "description": "Threads that are not sleeping. A rising count can indicate queued work or waits.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tassadar-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mysql_global_status_threads_running{job=\"mysql\",instance=~\"pxc-[0-9]+\"}",
          "legendFormat": "{{instance}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "title": "Client statements / s",
      "description": "Rate of Questions per node. Includes monitoring and other client traffic.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tassadar-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(mysql_global_status_questions{job=\"mysql\",instance=~\"pxc-[0-9]+\"}[$__rate_interval])",
          "legendFormat": "{{instance}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 9,
      "title": "Local Galera commits / s",
      "description": "Rate of writesets committed locally on each node.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tassadar-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(mysql_global_status_wsrep_local_commits{job=\"mysql\",instance=~\"pxc-[0-9]+\"}[$__rate_interval])",
          "legendFormat": "{{instance}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 10,
      "title": "Galera replication",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 11,
      "title": "Galera receive queue",
      "description": "Writesets waiting to be applied. A sustained queue suggests the node is falling behind.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tassadar-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mysql_global_status_wsrep_local_recv_queue{job=\"mysql\",instance=~\"pxc-[0-9]+\"}",
          "legendFormat": "{{instance}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 12,
      "title": "Time paused by flow control",
      "description": "Share of time during which replication was paused by Galera flow control.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tassadar-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * rate(mysql_global_status_wsrep_flow_control_paused_ns{job=\"mysql\",instance=~\"pxc-[0-9]+\"}[$__rate_interval]) / 1e9",
          "legendFormat": "{{instance}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 13,
      "title": "Galera write conflicts / s",
      "description": "Rates of certification failures and transaction aborts caused by replication.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tassadar-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(mysql_global_status_wsrep_local_cert_failures{job=\"mysql\",instance=~\"pxc-[0-9]+\"}[$__rate_interval])",
          "legendFormat": "{{instance}} certification",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "rate(mysql_global_status_wsrep_local_bf_aborts{job=\"mysql\",instance=~\"pxc-[0-9]+\"}[$__rate_interval])",
          "legendFormat": "{{instance}} apply conflict",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 14,
      "title": "PXC VM resources",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 15,
      "title": "VM CPU usage",
      "description": "CPU usage across all cores on each PXC VM.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tassadar-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 49,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{job=\"node\",instance=~\"pxc-[0-9]+\",mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "{{instance}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 16,
      "title": "VM memory usage",
      "description": "Used memory as a share of total RAM, based on MemAvailable.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tassadar-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 49,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"node\",instance=~\"pxc-[0-9]+\"} / node_memory_MemTotal_bytes{job=\"node\",instance=~\"pxc-[0-9]+\"})",
          "legendFormat": "{{instance}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 17,
      "title": "MySQL filesystem space used",
      "description": "Space in use on the filesystem mounted at /var/lib/mysql.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tassadar-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 57,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"node\",instance=~\"pxc-[0-9]+\",mountpoint=\"/var/lib/mysql\"} / node_filesystem_size_bytes{job=\"node\",instance=~\"pxc-[0-9]+\",mountpoint=\"/var/lib/mysql\"})",
          "legendFormat": "{{instance}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 18,
      "title": "MySQL data disk busy time",
      "description": "Share of time the block device backing /var/lib/mysql handled I/O.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tassadar-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 57,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (rate(node_disk_io_time_seconds_total{job=\"node\",instance=~\"pxc-[0-9]+\"}[$__rate_interval]) and on (instance, device) label_replace(node_filesystem_size_bytes{job=\"node\",instance=~\"pxc-[0-9]+\",mountpoint=\"/var/lib/mysql\"}, \"device\", \"$1\", \"device\", \"/dev/(.+)\"))",
          "legendFormat": "{{instance}} {{device}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 19,
      "title": "VM network traffic",
      "description": "Receive and transmit rates across non-loopback interfaces on each PXC VM.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tassadar-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 65,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(node_network_receive_bytes_total{job=\"node\",instance=~\"pxc-[0-9]+\",device!=\"lo\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} RX",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum by (instance) (rate(node_network_transmit_bytes_total{job=\"node\",instance=~\"pxc-[0-9]+\",device!=\"lo\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} TX",
          "instant": false,
          "range": true
        }
      ]
    }
  ]
}
