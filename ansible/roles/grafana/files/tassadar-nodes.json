{
  "uid": "tassadar-nodes",
  "title": "Tassadar — Nodes",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "tassadar",
    "nodes"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Nodes online",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "tassadar-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=\"node\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "tassadar-prometheus"
          },
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "CPU usage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tassadar-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by(instance) (rate(node_cpu_seconds_total{job=\"node\",mode=\"idle\"}[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "tassadar-prometheus"
          },
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Memory usage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tassadar-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"node\"} / node_memory_MemTotal_bytes{job=\"node\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "tassadar-prometheus"
          },
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Filesystem space used",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tassadar-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"node\",fstype!~\"tmpfs|devtmpfs|overlay\"} / node_filesystem_size_bytes{job=\"node\",fstype!~\"tmpfs|devtmpfs|overlay\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "tassadar-prometheus"
          },
          "legendFormat": "{{instance}} {{mountpoint}}"
        }
      ]
    }
  ]
}
