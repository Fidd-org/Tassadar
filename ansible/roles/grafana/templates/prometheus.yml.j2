apiVersion: 1
prune: true
datasources:
  - name: Prometheus
    uid: tassadar-prometheus
    type: prometheus
    access: proxy
    url: {{ ('http://' ~ grafana_prometheus_address ~ ':9090') | to_json }}
    isDefault: true
    editable: false
    jsonData:
      httpMethod: POST
      timeInterval: "15s"
