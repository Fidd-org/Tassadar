# Generated by prepare-inventory.yml from selected OpenTofu outputs.
all:
  vars:
    ansible_user: root
    ansible_ssh_private_key_file: {{ inventory_key_file | to_json }}
    ansible_ssh_common_args: {{ ('-F ' ~ (inventory_config_file | quote)) | to_json }}
  children:
    bastion:
      hosts:
        pxc-bastion:
          ansible_host: {{ inventory_bastion_ip | to_json }}
          node_exporter_address: {{ inventory_bastion_private_ip | to_json }}
    pxc:
      hosts:
{% for name, address in inventory_pxc_hosts | dictsort %}
        {{ name }}:
          ansible_host: {{ address | to_json }}
{% endfor %}
    flowerca:
      hosts:
        flowerca-1:
          ansible_host: {{ inventory_flowerca_ip | to_json }}
    monitoring:
      children:
        prometheus:
          hosts:
            prometheus-1:
              ansible_host: {{ inventory_monitoring_hosts['prometheus-1'] | to_json }}
        grafana:
          hosts:
            grafana-1:
              ansible_host: {{ inventory_monitoring_hosts['grafana-1'] | to_json }}
    node_exporter:
      children:
        bastion: {}
        pxc: {}
        flowerca: {}
        monitoring: {}
