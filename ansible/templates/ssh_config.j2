# Generated by prepare-inventory.yml; contains paths and addresses, never key material.
Host tassadar-bastion
    HostName {{ inventory_bastion_ip }}

Host {{ ((inventory_pxc_hosts.values() | list) + [inventory_flowerca_ip] + (inventory_monitoring_hosts.values() | list)) | join(' ') }}
    ProxyJump tassadar-bastion

Host *
    User root
    IdentityFile "{{ inventory_key_file }}"
    IdentitiesOnly yes
    IdentityAgent none
    BatchMode yes
    StrictHostKeyChecking yes
    UserKnownHostsFile "{{ inventory_hosts_file }}"
    GlobalKnownHostsFile /dev/null
    ForwardAgent no
    ConnectTimeout 15
    ServerAliveInterval 15
    ServerAliveCountMax 3
